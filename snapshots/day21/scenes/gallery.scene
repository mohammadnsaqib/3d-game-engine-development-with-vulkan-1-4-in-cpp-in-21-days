# THE GALLERY: ten scenes, and every one of them is something a previous day built.
#
# This is the file the shipped folder reads. It is 3 kilobytes of text beside a 340-kilobyte
# executable, and it is the only thing in the folder a player could sensibly edit.

meridian 2

scene opening
  camera    5.0 1.0 17.0
  look      0.230 0.115 68
  tonemap   aces
  exposure  1.0
  bloom     0.60 1.00
  dust      8000 drift box 30 0.8 1.0
  stars     14000 camera 1.0 1.2
  note      day 21, and nothing from the SDK
end

scene night
  camera    5.0 1.0 17.0
  look      0.230 0.115 68
  tonemap   aces
  exposure  0.45
  bloom     0.60 1.00
  dust      3000 drift box 30 0.7 1.0
  stars     5000 camera 0.8 1.0
  note      stopped down, and thinner
end

scene blaze
  camera    5.0 1.0 17.0
  look      0.230 0.115 68
  tonemap   aces
  exposure  1.0
  bloom     1.40 0.70
  dust      9000 drift box 30 1.0 9.0
  stars     14000 camera 1.3 7.0
  material  globe copper
  note      everything the HDR buffer can hold
end

